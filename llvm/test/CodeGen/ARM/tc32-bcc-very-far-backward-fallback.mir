# RUN: llc -mtriple=tc32-unknown-none-elf -run-pass=arm-cp-islands %s -o - | FileCheck %s

# CHECK-LABEL: bb.0:
# CHECK-NOT: tBfar
# CHECK: tPOP_RET
# CHECK: bb.1:
# CHECK: tPOP 14
# CHECK-NEXT: tB %bb.0, 14
# CHECK-LABEL: bb.3:
# CHECK: tBcc %bb.4, 0
# CHECK-LABEL: bb.4:
# CHECK: tPUSH 14
# CHECK-NEXT: tBfar %bb.1, 14
# CHECK-LABEL: bb.5:
# CHECK: tPOP_RET

--- |
  define void @f() { ret void }
...
---
name:            f
alignment:       2
tracksRegLiveness: false
body:             |
  bb.0:
    tPOP_RET 14, $noreg, def $pc

  bb.1:
    dead $r0 = SPACE 600000, undef $r0

  bb.2:
    tBcc %bb.0, 0, killed $cpsr

  bb.3:
    tPOP_RET 14, $noreg, def $pc
...
