# RUN: llc -mtriple=tc32-unknown-none-elf -run-pass=arm-cp-islands %s -o - | FileCheck %s

# CHECK-LABEL: bb.0:
# CHECK-NOT: tTC32B32
# CHECK: tBcc %bb.1, 1
# CHECK: tPUSH 14
# CHECK-NEXT: tBfar %bb.[[VENEER:[0-9]+]], 14
# CHECK: bb.[[VENEER]]:
# CHECK: tPOP 14
# CHECK: bb.{{[0-9]+}}:
# CHECK: tPOP_RET

--- |
  define void @f() { ret void }
...
---
name:            f
alignment:       2
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $cpsr
    tBcc %bb.2, 0, killed $cpsr
    tPOP_RET 14, $noreg, def $pc

  bb.1:
    dead $r0 = SPACE 600000, undef $r0

  bb.2:
    tPOP_RET 14, $noreg, def $pc
...
