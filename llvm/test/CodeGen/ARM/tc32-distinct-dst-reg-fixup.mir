# RUN: llc -mtriple=tc32-unknown-none-elf -run-pass=tc32-distinct-dst-reg-fixup -verify-machineinstrs %s -o - | FileCheck %s

--- |
  define i32 @distinct_dst_sub_rhs(i32 %a, i32 %b) { ret i32 0 }
...
---
name:            distinct_dst_sub_rhs
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r0, $r1

    ; CHECK-LABEL: name: distinct_dst_sub_rhs
    ; CHECK: $r0, dead $cpsr = tMVN killed $r0
    ; CHECK-NEXT: tCMPr $r0, $r0
    ; CHECK-NEXT: $r0, dead $cpsr = tADC $r0, killed $r1
    renamable $r0, dead $cpsr = tSUBrr killed renamable $r1, killed renamable $r0, 14, $noreg
    tBX_RET 14, $noreg, implicit $r0
