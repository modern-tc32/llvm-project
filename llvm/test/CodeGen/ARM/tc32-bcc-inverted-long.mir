# RUN: llc -mtriple=tc32-unknown-none-elf -run-pass=arm-cp-islands %s -o - | FileCheck %s

# CHECK-LABEL: bb.0:
# CHECK-NOT: tTC32Bcc32
# CHECK: tBcc %bb.1, 5
# CHECK-NEXT: tTC32B32 %bb.3
# CHECK-LABEL: bb.1:

--- |
  define void @f() { ret void }
...
---
name:            f
alignment:       2
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $cpsr
    tBcc %bb.1, 5, killed $cpsr
    tB %bb.3, 14, $noreg

  bb.1:
    tPOP_RET 14, $noreg, def $pc

  bb.2:
    dead $r0 = SPACE 3000, undef $r0

  bb.3:
    tPOP_RET 14, $noreg, def $pc
...
