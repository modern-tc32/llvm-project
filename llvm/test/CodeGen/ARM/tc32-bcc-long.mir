# RUN: llc -mtriple=tc32-unknown-none-elf -run-pass=arm-cp-islands %s -o - | FileCheck %s

# CHECK-LABEL: bb.0:
# CHECK-NOT: tTC32Bcc32
# CHECK: tBcc %bb.[[SKIP:[0-9]+]], 1
# CHECK-NEXT: tPUSH 14
# CHECK-NEXT: tBfar %bb.[[TAKEN:[0-9]+]], 14
# CHECK: bb.[[SKIP]]:
# CHECK: tPOP_RET
# CHECK: bb.[[TAKEN]]:
# CHECK: tPOP 14

--- |
  define void @f() { ret void }
...
---
name:            f
alignment:       2
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $cpsr
    tBcc %bb.2, 0, killed $cpsr
    tPOP_RET 14, $noreg, def $pc

  bb.1:
    dead $r0 = SPACE 3000, undef $r0

  bb.2:
    tPOP_RET 14, $noreg, def $pc
...
