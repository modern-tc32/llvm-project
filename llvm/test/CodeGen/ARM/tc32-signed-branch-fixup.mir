# RUN: llc -mtriple=tc32-unknown-none-elf -run-pass=tc32-signed-branch-fixup %s -o - | FileCheck %s

# CHECK-LABEL: name: no_op_fallthrough
# CHECK: bb.0:
# CHECK-NOT: tBcc
# CHECK: bb.1:
# CHECK: tPOP_RET

--- |
  define void @no_op_fallthrough() { ret void }
...
---
name:            no_op_fallthrough
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1(0x80000000)
    liveins: $cpsr

    tBcc %bb.1, 0, killed $cpsr

  bb.1:
    tPOP_RET 14, $noreg, def $pc
...
